table Fact_Orders
	lineageTag: 263f1695-6dc9-4674-8e8c-9e9b9db2c195
	sourceLineageTag: b7ad75bc-c675-4533-baf0-179d92ea4dba

	/// Total revenue = sum of order price.
	measure 'Total Sales' = SUM ( Fact_Orders[price] )
		displayFolder: KPIs
		lineageTag: e8a79d8a-b550-449a-bcb0-e352be90cead

		formatStringDefinition =
				SWITCH (
				    TRUE (),
				    ABS ( SELECTEDMEASURE () ) >= 1000000, "$#,0.00,,""M""",
				    ABS ( SELECTEDMEASURE () ) >= 1000, "$#,0.00,""K""",
				    "$#,0.00"
				)

		changedProperty = IsHidden

	/// Number of distinct orders.
	measure 'Total Orders' = DISTINCTCOUNT ( Fact_Orders[order_id] )
		displayFolder: KPIs
		lineageTag: 2f2cd832-7569-4ba1-ae0c-2f3627994b58

		formatStringDefinition =
				SWITCH (
				    TRUE (),
				    ABS ( SELECTEDMEASURE () ) >= 1000000, "#,0.00,,""M""",
				    ABS ( SELECTEDMEASURE () ) >= 1000, "#,0.00,""K""",
				    "#,0"
				)

		changedProperty = IsHidden

	/// Total Sales divided by Total Orders.
	measure 'Avg Order Value' = DIVIDE ( [Total Sales], [Total Orders] )
		formatString: $#,0.00
		displayFolder: KPIs
		lineageTag: 4cf3073e-f0f8-4ae6-9994-4ae5f946c71c

		changedProperty = IsHidden

	/// Simple average of order rating.
	measure 'Avg Rating' = AVERAGE ( Fact_Orders[rating] )
		formatString: 0.00
		displayFolder: KPIs
		lineageTag: ad93ee0a-9445-4d73-906c-3beb62934277

		changedProperty = IsHidden

	/// Total number of customer ratings.
	measure 'Rating Count' = SUM ( Fact_Orders[rating_count] )
		displayFolder: KPIs
		lineageTag: cd851071-f8e0-4cc2-bc48-1cdec3fc4140

		formatStringDefinition =
				SWITCH (
				    TRUE (),
				    ABS ( SELECTEDMEASURE () ) >= 1000000, "#,0.00,,""M""",
				    ABS ( SELECTEDMEASURE () ) >= 1000, "#,0.00,""K""",
				    "#,0"
				)

		changedProperty = IsHidden

	/// Share of sales within the current slicer selection.
	measure 'Sales % of Total' =
			DIVIDE (
			    [Total Sales],
			    CALCULATE ( [Total Sales], ALLSELECTED () )
			)
		formatString: 0.0%
		displayFolder: Analysis
		lineageTag: d05ad41a-b5d0-46d9-9f81-6838ecd799e0

		changedProperty = IsHidden

