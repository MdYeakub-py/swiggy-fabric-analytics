		annotation SummarizationSetBy = User

	column 'Food Type' =
			VAR _n = UPPER ( Dim_Dish[dish_name] )
			RETURN
			IF (
			    ( CONTAINSSTRING ( _n, "CHICKEN" ) || CONTAINSSTRING ( _n, "MUTTON" ) || CONTAINSSTRING ( _n, "EGG" )
			        || CONTAINSSTRING ( _n, "FISH" ) || CONTAINSSTRING ( _n, "PRAWN" ) || CONTAINSSTRING ( _n, "NON VEG" )
			        || CONTAINSSTRING ( _n, "NONVEG" ) || CONTAINSSTRING ( _n, "NON-VEG" ) || CONTAINSSTRING ( _n, "KEEMA" )
			        || CONTAINSSTRING ( _n, "SEAFOOD" ) || CONTAINSSTRING ( _n, "LAMB" ) || CONTAINSSTRING ( _n, "PORK" )
			        || CONTAINSSTRING ( _n, "BEEF" ) || CONTAINSSTRING ( _n, "SHAWARMA" ) || CONTAINSSTRING ( _n, "PEPPERONI" )
			        || CONTAINSSTRING ( _n, "BACON" ) || CONTAINSSTRING ( _n, "SAUSAGE" ) || CONTAINSSTRING ( _n, "SALAMI" )
			        || CONTAINSSTRING ( _n, "HAM " ) || CONTAINSSTRING ( _n, "CRAB" ) || CONTAINSSTRING ( _n, "SHRIMP" )
			        || CONTAINSSTRING ( _n, "TUNA" ) || CONTAINSSTRING ( _n, "ZINGER" ) || CONTAINSSTRING ( _n, "GRILLICKEN" ) )
			        && NOT ( CONTAINSSTRING ( _n, "EGGLESS" ) || CONTAINSSTRING ( _n, "EGG LESS" ) ),
			    "Non-Veg",
			    "Veg"
			)
		dataType: string
		lineageTag: 19743676-d6ff-4637-b683-214bada01460
		summarizeBy: none

		changedProperty = IsHidden

	partition Dim_Dish = entity
		mode: directQuery
		source
